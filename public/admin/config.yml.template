backend:
  name: github
  repo: FranekKimono/bingethinkers.com
  branch: master
  base_url: https://bingethinkers.com
  auth_endpoint: /api/auth

media_folder: public/images
public_folder: /images

site_url: https://bingethinkers.com
display_url: https://bingethinkers.com
logo:
  src: /title.png
  show_in_header: true

collections:
  - name: pages
    label: Pages
    files:
      - name: home
        label: Home Page
        file: content/settings/home.md
        fields:
          - { label: Admin Title, name: title, widget: hidden, default: Home Page }
          - { label: Hero Title, name: heroTitle, widget: string }
          - { label: Hero Subtitle, name: heroSubtitle, widget: string }
          - { label: CTA Text, name: ctaText, widget: string }
          - { label: Intro Eyebrow, name: introEyebrow, widget: string }
          - { label: Intro Heading, name: introTitle, widget: string }
          - { label: Intro Copy, name: introBody, widget: text }
          - { label: Calendar Heading, name: eventsTitle, widget: string }
          - { label: Calendar Intro, name: eventsSubtitle, widget: text }
          - { label: Bottom CTA Heading, name: bottomCtaTitle, widget: string }
          - { label: Bottom CTA Copy, name: bottomCtaBody, widget: text }
          - { label: Bottom CTA Button, name: bottomCtaText, widget: string }

      - name: testimonials
        label: Testimonials
        file: content/settings/testimonials.md
        fields:
          - { label: Admin Title, name: title, widget: hidden, default: Testimonials }
          - { label: Page Introduction, name: intro, widget: text }
          - { label: Clients Heading, name: clientsTitle, widget: string }
          - { label: Testimonials Heading, name: quotesTitle, widget: string }
          - label: Testimonials
            name: testimonials
            widget: list
            summary: '{{fields.name}} — {{fields.role}}'
            fields:
              - { label: Quote, name: quote, widget: text }
              - { label: Name, name: name, widget: string }
              - { label: Role / Organization, name: role, widget: string }

      - name: contact
        label: Book & Contact
        file: content/settings/contact.md
        fields:
          - { label: Admin Title, name: title, widget: hidden, default: Book & Contact }
          - { label: Page Introduction, name: intro, widget: text }
          - { label: Pricing Heading, name: pricingTitle, widget: string }
          - { label: Pricing Paragraph 1, name: pricingBody, widget: text }
          - { label: Pricing Paragraph 2, name: pricingCta, widget: text }

      - name: our-story
        label: Our Story
        file: content/our-story.md
        fields:
          - { label: Title, name: title, widget: string }
          - { label: Search Description, name: description, widget: text }
          - { label: Body, name: body, widget: markdown }

      - name: faq
        label: Frequently Asked Questions
        file: content/faq.md
        fields:
          - { label: Title, name: title, widget: string }
          - { label: Search Description, name: description, widget: text }
          - { label: Body, name: body, widget: markdown }

      - name: privacy
        label: Privacy Policy
        file: content/privacy.md
        fields:
          - { label: Title, name: title, widget: string }
          - { label: Search Description, name: description, widget: text }
          - { label: Body, name: body, widget: markdown }

  - name: events
    label: Calendar Events
    files:
      - label: Events
        name: events
        file: data/events.json
        format: json
        fields:
          - label: Events
            name: events
            widget: list
            summary: '{{fields.title}} — {{fields.venue}}'
            fields:
              - { label: ID, name: id, widget: string, hint: 'Unique slug, e.g. weekly-x-cues or rec-room-2026-06-02' }
              - { label: Title, name: title, widget: string, default: 'Trivia Night' }
              - { label: Venue, name: venue, widget: string }
              - { label: Time, name: time, widget: string, hint: 'e.g. 7:00 PM' }
              - label: Recurrence
                name: recurrence
                widget: object
                collapsed: false
                fields:
                  - label: Type
                    name: type
                    widget: select
                    options:
                      - { label: One-time date, value: once }
                      - { label: Every week, value: weekly }
                      - { label: Every month (day of month), value: monthly }
                      - { label: Monthly weekday (e.g. 2nd Tuesday), value: monthlyWeekday }
                  - { label: Date (once only), name: date, widget: string, required: false, hint: 'YYYY-MM-DD — only when type is once' }
                  - label: Day of week
                    name: dayOfWeek
                    widget: select
                    required: false
                    hint: 'For weekly or monthlyWeekday'
                    options:
                      - { label: Sunday, value: 0 }
                      - { label: Monday, value: 1 }
                      - { label: Tuesday, value: 2 }
                      - { label: Wednesday, value: 3 }
                      - { label: Thursday, value: 4 }
                      - { label: Friday, value: 5 }
                      - { label: Saturday, value: 6 }
                  - { label: Day of month (monthly only), name: dayOfMonth, widget: number, value_type: int, min: 1, max: 31, required: false }
                  - label: Which weekday of the month (monthlyWeekday only)
                    name: nth
                    widget: select
                    required: false
                    options:
                      - { label: 1st, value: 1 }
                      - { label: 2nd, value: 2 }
                      - { label: 3rd, value: 3 }
                      - { label: 4th, value: 4 }
                      - { label: 5th, value: 5 }
