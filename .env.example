# Copy to .env for local dev. Never commit .env.
# In production, set these in Cloudflare Pages → Settings → Environment variables.

# Decap CMS GitHub OAuth (Nuxt worker routes in server/api)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Decap event address suggestions (public browser key; restrict by referrer and API)
GOOGLE_MAPS_API_KEY=

# Contact form (server/api/contact.post.ts)
RESEND_API_KEY=

# Instagram feed (server/api/instagram.get.ts)
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=
