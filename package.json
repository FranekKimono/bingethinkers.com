{
  "name": "bingethinkers",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-admin.mjs && nuxt dev",
    "build": "node scripts/prepare-admin.mjs && nuxt build",
    "generate": "node scripts/prepare-admin.mjs && nuxt generate",
    "postgenerate": "node scripts/verify-cloudflare-worker.mjs && node scripts/patch-oauth-routes.mjs",
    "postbuild": "node scripts/verify-cloudflare-worker.mjs && node scripts/patch-oauth-routes.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "nuxt prepare && vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "nuxt": "4.6.4",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@nuxt/image": "2.2.1",
    "@react-email/render": "2.3.1",
    "resend": "6.38.1",
    "xss": "1.0.17"
  },
  "type": "module",
  "overrides": {
    "readdir-glob": {
      "minimatch": "^11.0.9"
    }
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
